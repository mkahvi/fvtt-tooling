[*]
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = 2
tab_width = 2
quote_style = single

[*.{js,mjs,ts}]
charset = utf-8
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
tab_width = 2

[*.md]
charset = utf-8
trim_trailing_whitespace = false
indent_style = space
tab_width = 2
